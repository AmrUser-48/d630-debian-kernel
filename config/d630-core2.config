# Dell Latitude D630: Debian Bookworm Linux source 6.1.180-1.
# Merged into Debian's generated amd64 runtime image configuration.
# The policy generator sets the custom Debian target ABI/LOCALVERSION and validates KERNELRELEASE.

# Intel Core 2 Duo T7250 (Merom). Never use the CI runner's native CPU target.
CONFIG_MCORE2=y
# CONFIG_GENERIC_CPU is not set
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y

# CPU scaling on the D630: ACPI P-states plus the built-in userspace governor.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_X86_ACPI_CPUFREQ=m

# Built-in microcode plus Intel PRO/Wireless 3945ABG firmware.
CONFIG_MICROCODE=y
CONFIG_MICROCODE_INTEL=y
CONFIG_FW_LOADER=y
CONFIG_EXTRA_FIRMWARE="intel-ucode/06-0f-0d iwlwifi-3945-2.ucode"
CONFIG_EXTRA_FIRMWARE_DIR="/lib/firmware"

# Compact kernel image without debug-symbol payloads.
CONFIG_KERNEL_XZ=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
# CONFIG_GDB_SCRIPTS is not set

# Keep ordinary Debian modules and unloading; psmouse remains reloadable.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# Zstandard-compress all installed modules (.ko.zst); Bookworm kmod supports it.
# CONFIG_MODULE_COMPRESS_NONE is not set
# CONFIG_MODULE_COMPRESS_GZIP is not set
# CONFIG_MODULE_COMPRESS_XZ is not set
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MOUSE_PS2=m
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_MOUSEDEV_PSAUX=y

# Boot-critical filesystems and automounter.
CONFIG_AUTOFS4_FS=y
CONFIG_AUTOFS_FS=y
CONFIG_EXT4_FS=y
# FUSE supports NTFS-3G, AppImage and other userspace filesystems.
CONFIG_FUSE_FS=m
CONFIG_CUSE=m
CONFIG_OVERLAY_FS=m
# EFI variable access is available on EFI-capable machines; harmless on legacy BIOS.
CONFIG_EFI=y
CONFIG_EFIVAR_FS=m
# Additional local filesystems useful for removable disks and recovery images.
CONFIG_XFS_FS=m
CONFIG_F2FS_FS=m
CONFIG_EROFS_FS=m
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_NTFS3_64BIT_CLUSTER=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_UDF_FS=y
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_NLS=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y

# Network filesystems for NAS/Windows shares and remote mounts.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=m
# CONFIG_NFS_V2 is not set
CONFIG_NFS_V3=m
CONFIG_NFS_V4=m
CONFIG_NFSD=m
# CONFIG_NFSD_V4 is not set
CONFIG_CIFS=m
CONFIG_CIFS_XATTR=y
# Do not enable obsolete SMB1/SMB2.0 dialects for CIFS.
# CONFIG_CIFS_ALLOW_INSECURE_LEGACY is not set
CONFIG_SMB_SERVER=m

# zram built in, LZ4 default; retain all Linux 6.1 zram compressors:
# lzo-rle, zstd, lz4, lzo, lz4hc, and 842.
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
# Select exactly one default-compressor choice; do not inherit Debian's LZO-RLE choice.
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
# CONFIG_ZRAM_DEF_COMP_ZSTD is not set
CONFIG_ZRAM_DEF_COMP_LZ4=y
# CONFIG_ZRAM_DEF_COMP_LZO is not set
# CONFIG_ZRAM_DEF_COMP_LZ4HC is not set
# CONFIG_ZRAM_DEF_COMP_842 is not set
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_842=y
CONFIG_LZO_COMPRESS=y
CONFIG_LZO_DECOMPRESS=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y
CONFIG_LZ4HC_COMPRESS=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y

# D630 Wi-Fi: Intel PRO/Wireless 3945ABG (8086:4222).
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=y
CONFIG_IWLEGACY=m
CONFIG_IWL3945=m
CONFIG_IWL4965=m
# Newer replacement Intel Wi-Fi cards.
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m

# D630 audio: Intel ICH8 HDA plus the Sigmatel/IDT codec.
# SND_HDA is selected by the modular controller, so Kconfig resolves it to m.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_DRIVERS=y
CONFIG_SND_PCM_TIMER=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=m
# Hidden OPL3/MIDI-emulation helpers are selected by legacy synth drivers;
# do not force them after pruning those unrelated ISA sound-card drivers.
CONFIG_SND_HRTIMER=m
CONFIG_SND_HWDEP=m
CONFIG_SND_SEQUENCER=m
CONFIG_SND_SEQ_DUMMY=m
CONFIG_SND_SEQ_HRTIMER_DEFAULT=y
CONFIG_SND_SEQ_MIDI_EVENT=m
CONFIG_SND_SEQ_MIDI=m
CONFIG_SND_SEQ_VIRMIDI=m
CONFIG_SND_VIRMIDI=m
CONFIG_SND_SEQ_DEVICE=m
CONFIG_SND_RAWMIDI=m
# CONFIG_SND_HDA_I915 is not set

# Keep Intel GM965/i915 and AGP values exactly as Debian's baseline generates.
# CONFIG_DRM_I915 and CONFIG_AGP_INTEL are intentionally not forced here.

# Keep nftables FIB support at the native Debian config values.

# Explicitly exclude unrelated hardware/protocol modules absent from or not
# required by the D630.
# CONFIG_ALTERA_STAPL is not set
# CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND is not set
# CONFIG_MXM_WMI is not set
# CONFIG_SLIMBUS is not set
# CONFIG_VIDEO_CS3308 is not set
# CONFIG_VIDEO_CS5345 is not set
# CONFIG_CHELSIO_LIB is not set
# CONFIG_CRYPTO_DEV_VIRTIO is not set
# CONFIG_CRYPTO_ENGINE is not set
# CONFIG_CYPRESS_FIRMWARE is not set
# CONFIG_DRM_SCHED is not set
# CONFIG_FB_BACKLIGHT is not set
# CONFIG_FB_DDC is not set
# CONFIG_KEYBOARD_APPLESPI is not set
# CONFIG_PTP_1588_CLOCK_OCP is not set
# CONFIG_SMC is not set
# CONFIG_SMC_DIAG is not set
# CONFIG_TOUCHSCREEN_WM97XX is not set
# CONFIG_USB_EG20T is not set
# CONFIG_VIDEO_VIA_CAMERA is not set
# CONFIG_X86_ANDROID_TABLETS is not set

# Exclude hardware/protocol families absent from this SATA-era laptop.
# CONFIG_CAN is not set
# CONFIG_ISDN is not set
# CONFIG_INFINIBAND is not set
# CONFIG_FIREWIRE is not set
# CONFIG_NFC is not set
# CONFIG_WIMAX is not set
# CONFIG_IEEE802154 is not set
# CONFIG_6LOWPAN is not set
# CONFIG_USB_GADGET is not set
# CONFIG_USB_NET2280 is not set
# CONFIG_DEV_DAX_HMEM is not set
# CONFIG_MTD is not set
# Virtual-machine guest drivers; optional device drivers remain modules.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=m
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_CONSOLE=m
CONFIG_VIRTIO_BALLOON=m
CONFIG_VIRTIO_INPUT=m
CONFIG_VIRTIO_MMIO=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_VIRTIO_FS=m

# Xen guest frontends for booting/testing under Xen.
CONFIG_XEN=y
CONFIG_XEN_PVHVM_GUEST=y
CONFIG_XEN_PVH=y
CONFIG_XEN_BLKDEV_FRONTEND=m
CONFIG_XEN_NETDEV_FRONTEND=m
CONFIG_XEN_SCSI_FRONTEND=m
CONFIG_HVC_XEN=y

# No NVMe host, fabric, or target support.
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_NVME_CORE is not set
# CONFIG_NVME_MULTIPATH is not set
# CONFIG_NVME_FABRICS is not set
# CONFIG_NVME_FC is not set
# CONFIG_NVME_TCP is not set
# CONFIG_NVME_RDMA is not set
# CONFIG_NVME_TARGET is not set
# CONFIG_NVME_TARGET_FC is not set
# CONFIG_NVME_TARGET_FCLOOP is not set
# CONFIG_NVME_TARGET_TCP is not set
# CONFIG_NVME_TARGET_RDMA is not set

# Remove unused SCSI host adapters/transports, but keep SCSI core, SATA/AHCI,
# disks, ATAPI optical drive and USB mass storage.
# Enable the SCSI low-level menu and selected multipath handlers.
CONFIG_SCSI_LOWLEVEL=y
CONFIG_SCSI_DH=y
CONFIG_SCSI_DH_ALUA=m
CONFIG_SCSI_DH_EMC=m
CONFIG_SCSI_DH_HP_SW=m
CONFIG_SCSI_DH_RDAC=m
CONFIG_ISCSI_TCP=m
# Selected common RAID/SAS adapters remain modular for add-on cards and VM use.
CONFIG_MEGARAID_SAS=m
CONFIG_SCSI_MPT2SAS=m
CONFIG_SCSI_MPT3SAS=m
CONFIG_SCSI_SMARTPQI=m
CONFIG_SCSI_HPSA=m
CONFIG_SCSI_AACRAID=m
CONFIG_SCSI_AIC7XXX=m
CONFIG_SCSI_AIC79XX=m
# CONFIG_SCSI_LOWLEVEL_PCMCIA is not set
# CONFIG_ENCLOSURE_SERVICES is not set
# CONFIG_SCSI_ENCLOSURE is not set
# CONFIG_SCSI_SPI_ATTRS is not set
# CONFIG_SCSI_FC_ATTRS is not set
# CONFIG_SCSI_ISCSI_ATTRS is not set
# CONFIG_SCSI_SRP_ATTRS is not set
# CONFIG_RAID_ATTRS is not set
# CONFIG_CHR_DEV_ST is not set
# CONFIG_CHR_DEV_SCH is not set
# CONFIG_CHR_DEV_SG is not set
# CONFIG_SCSI_DEBUG is not set
# CONFIG_SCSI_UFSHCD is not set
# CONFIG_SCSI_UFSHCD_PCI is not set
# CONFIG_SCSI_UFSHCD_PLATFORM is not set
# CONFIG_SCSI_UFS_DWC_TC_PCI is not set

# No DVB/radio/SDR/test-media APIs; retain the V4L2/USB-webcam core.
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_ANALOG_TV_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
# CONFIG_DVB_CORE is not set
# CONFIG_RADIO_ADAPTERS is not set

# The audited policy sets the Debian image target ABI and kernelrelease.
# CONFIG_LOCALVERSION_AUTO is not set
