# D630 custom overlay on Debian's native amd64 kernel configuration.
# The full effective-config diff is generated and audited during each build.

# Tune the x86-64 kernel for the Intel Core 2 Duo T7250 (Merom).
CONFIG_MCORE2=y
# CONFIG_GENERIC_CPU is not set

# Built-in early microcode for Intel Core 2 Duo T7250 (CPUID 06fd).
CONFIG_MICROCODE=y
CONFIG_MICROCODE_INTEL=y
CONFIG_FW_LOADER=y
CONFIG_EXTRA_FIRMWARE="intel-ucode/06-0f-0d"
CONFIG_EXTRA_FIRMWARE_DIR="/lib/firmware"

# Built-in filesystems requested for the target; ISO9660 intentionally stays modular.
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_NTFS3_FS=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_UDF_FS=y
CONFIG_ISO9660_FS=m

# Built-in zram; preserve Debian's default LZO-RLE compressor and its dependencies.
CONFIG_CRYPTO_LZO=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM_DEF_COMP_LZORLE=y
CONFIG_LZO_COMPRESS=y
CONFIG_LZO_DECOMPRESS=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y

# Keep the PS/2 touchpad driver reloadable; preserve Debian's built-in GPM mouse interface.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MOUSE_PS2=m
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_MOUSEDEV_PSAUX=y

# Preserve nftables FIB expression support required by firewalld inet rules.
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m

# Kernel runtime release is supplied by Debian's native build rule.
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set

# Stripped runtime kernel: choose "Disable debug information" in Kconfig.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
# CONFIG_GDB_SCRIPTS is not set

# Explicit exclusions: these interfaces are not part of the D630 target.
# Keep parent switches disabled so Kconfig cannot re-enable their child modules.
# CONFIG_CAN is not set
# CONFIG_ISDN is not set
# CONFIG_INFINIBAND is not set
# CONFIG_FIREWIRE is not set
# CONFIG_NFC is not set
# CONFIG_WIMAX is not set
# CONFIG_IEEE802154 is not set
# CONFIG_6LOWPAN is not set
# CONFIG_USB_GADGET is not set

# No NVMe host, fabric, or target support on this SATA-era laptop.
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_NVME_CORE is not set
# CONFIG_NVME_MULTIPATH is not set
# CONFIG_NVME_FABRICS is not set
# CONFIG_NVME_FC is not set
# CONFIG_NVME_TCP is not set
# CONFIG_NVME_RDMA is not set
# CONFIG_NVME_TARGET is not set
# CONFIG_NVME_TARGET_FC is not set
# CONFIG_NVME_TARGET_FCLOOP is not set
# CONFIG_NVME_TARGET_TCP is not set
# CONFIG_NVME_TARGET_RDMA is not set
# CONFIG_NVME_HWMON is not set
# CONFIG_NVME_AUTH is not set
# CONFIG_NVME_TARGET_AUTH is not set

# Retain camera/analog/platform video support, but disable all digital-TV/DVB,
# radio, SDR and test-only media APIs. The D630 has no DVB tuner hardware.
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_ANALOG_TV_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
# CONFIG_DVB_CORE is not set
# CONFIG_RADIO_ADAPTERS is not set

# No flash/MTD devices on this target.
# CONFIG_MTD is not set

# Unused platform-specific interfaces absent from the D630 hardware.
# CONFIG_ALTERA_STAPL is not set
# CONFIG_SCSI_SRP_ATTRS is not set
