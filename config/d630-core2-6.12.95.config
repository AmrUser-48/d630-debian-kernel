# Dell Latitude D630: Debian Bookworm backports Linux 6.12.95.
# This is an overlay on Debian's own amd64 / rt feature-set config.
# Keep this in sync with docs/d630-6.12.95-plan.md.
#
# Intel Core 2 Duo T7250 is an x86-64 Core 2. On Linux 6.12 MCORE2 exists for
# x86-64, so select it explicitly; never use the CI runner's -march=native.
CONFIG_MCORE2=y
# CONFIG_GENERIC_CPU is not set
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y

# Early CPU microcode and the exact firmware requested by Intel 3945ABG.
CONFIG_MICROCODE=y
CONFIG_MICROCODE_INTEL=y
CONFIG_FW_LOADER=y
CONFIG_EXTRA_FIRMWARE="intel-ucode/06-0f-0d iwlwifi-3945-2.ucode"
CONFIG_EXTRA_FIRMWARE_DIR="/lib/firmware"

# Compact image. Kconfig's "Disable debug information" choice removes DWARF
# from the runtime build; only the image target is built and published.
CONFIG_KERNEL_XZ=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
# CONFIG_GDB_SCRIPTS is not set

# Retain Debian modules/unloading so normal kernel drivers remain available.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MOUSE_PS2=m
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_MOUSEDEV_PSAUX=y

# Built-in storage filesystems needed by Debian and the D630's multi-partition
# boot/root layout. ISO9660 remains modular to avoid baking in optical-media
# support unnecessarily.
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_NTFS3_64BIT_CLUSTER=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_UDF_FS=y
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=m
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_NLS=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y

# zram built into vmlinux with LZ4 default. Keep every compressor provided
# by Linux 6.12 available: LZO-RLE/LZO, Zstd, LZ4, LZ4HC, DEFLATE and 842.
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZ4HC=y
CONFIG_ZRAM_BACKEND_DEFLATE=y
CONFIG_ZRAM_BACKEND_842=y

# Intel PRO/Wireless 3945ABG (PCI 8086:4222). Driver remains loadable; the
# firmware blob is compiled into the kernel so an initramfs needs no copy.
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=y
CONFIG_IWLEGACY=m
CONFIG_IWL3945=m
# CONFIG_IWL4965 is not set
# CONFIG_IWLWIFI is not set

# D630 Intel ICH8 HD Audio + SigmaTel/IDT STAC9205 codec. Linux 6.12 uses
# SND_HDA_CODEC_SIGMATEL; the resulting module is snd-hda-codec-idt.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_SIGMATEL=m
# CONFIG_SND_HDA_I915 is not set
# CONFIG_SND_SEQUENCER is not set
# CONFIG_SND_RAWMIDI is not set

# Keep Debian's baseline values for the Intel GM965/GMA X3100 i915/AGP stack,
# SATA/AHCI, PATA/ATAPI, SCSI disk/CD, USB mass storage and nftables FIB.
# The hardware inventory confirms no other GPU/vendor firmware is needed.

# Hardware/protocol families not present on this SATA-era laptop.
# CONFIG_CAN is not set
# CONFIG_ISDN is not set
# CONFIG_INFINIBAND is not set
# CONFIG_FIREWIRE is not set
# CONFIG_NFC is not set
# CONFIG_WIMAX is not set
# CONFIG_IEEE802154 is not set
# CONFIG_6LOWPAN is not set
# CONFIG_USB_GADGET is not set
# CONFIG_MTD is not set
# CONFIG_XEN is not set
# CONFIG_VIRTIO is not set
# CONFIG_EFI is not set
# CONFIG_EFI_STUB is not set
# CONFIG_EFI_MIXED is not set

# No NVMe host, fabric or target device on the D630.
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_NVME_CORE is not set
# CONFIG_NVME_MULTIPATH is not set
# CONFIG_NVME_FABRICS is not set
# CONFIG_NVME_FC is not set
# CONFIG_NVME_TCP is not set
# CONFIG_NVME_RDMA is not set
# CONFIG_NVME_TARGET is not set
# CONFIG_NVME_TARGET_FC is not set
# CONFIG_NVME_TARGET_FCLOOP is not set
# CONFIG_NVME_TARGET_TCP is not set
# CONFIG_NVME_TARGET_RDMA is not set

# Remove unused SCSI host adapters/transports, preserving the SCSI mid-layer,
# SATA/libata/AHCI, disk/CD support and USB mass storage.
# CONFIG_SCSI_LOWLEVEL is not set
# CONFIG_SCSI_LOWLEVEL_PCMCIA is not set
# CONFIG_ENCLOSURE_SERVICES is not set
# CONFIG_SCSI_ENCLOSURE is not set
# CONFIG_SCSI_DH is not set
# CONFIG_SCSI_SPI_ATTRS is not set
# CONFIG_SCSI_FC_ATTRS is not set
# CONFIG_SCSI_ISCSI_ATTRS is not set
# CONFIG_SCSI_SAS_ATTRS is not set
# CONFIG_SCSI_SAS_LIBSAS is not set
# CONFIG_SCSI_SRP_ATTRS is not set
# CONFIG_RAID_ATTRS is not set
# CONFIG_CHR_DEV_ST is not set
# CONFIG_CHR_DEV_SCH is not set
# CONFIG_CHR_DEV_SG is not set
# CONFIG_SCSI_DEBUG is not set
# CONFIG_SCSI_UFSHCD is not set
# CONFIG_SCSI_UFSHCD_PCI is not set
# CONFIG_SCSI_UFSHCD_PLATFORM is not set
# CONFIG_SCSI_UFS_DWC_TC_PCI is not set

# No DVB, radio-adapter, SDR or synthetic test-media APIs. Preserve the V4L2
# core and USB webcams.
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_ANALOG_TV_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
# CONFIG_DVB_CORE is not set
# CONFIG_RADIO_ADAPTERS is not set

# Debian's native image target controls the final kernelrelease and ABI.
# CONFIG_LOCALVERSION_AUTO is not set
