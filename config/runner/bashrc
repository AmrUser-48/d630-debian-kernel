# D630 interactive runner shell profile.
# Appended to the runner image's stock .bashrc; does not replace it.

[[ $- == *i* ]] || return

if [[ -r "$HOME/.config/d630-runner/env" ]]; then
  source "$HOME/.config/d630-runner/env"
fi

export PATH="$HOME/.local/bin:$PATH"
export EDITOR=nvim
export VISUAL=nvim
export PAGER='less -FRX'
export MANPAGER='less -R'
export GIT_PAGER='less -FRX'

export HISTCONTROL=ignoreboth:erasedups
export HISTSIZE=10000
export HISTFILESIZE=20000
export HISTTIMEFORMAT='%F %T '
shopt -s histappend checkwinsize cmdhist

# Kernel and package builds target the D630's Core 2 Duo.
# BUILD_JOBS follows the hosted runner's available CPUs, not the laptop's 2 cores.
export ARCH=x86_64
export KCFLAGS="${KCFLAGS:--march=core2 -mtune=core2}"
export BUILD_JOBS="${BUILD_JOBS:-$(nproc)}"
export MAKEFLAGS="${MAKEFLAGS:--j$BUILD_JOBS}"

alias ll='ls -lahF --group-directories-first'
alias la='ls -A --group-directories-first'
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias vi='nvim'
alias vim='nvim'
alias v='nvim'
alias gs='git status --short --branch'
alias gl='git log --oneline --decorate --graph -15'

lfcd() {
  local last_dir
  last_dir="$(mktemp)"
  lf -last-dir-path="$last_dir" "$@"
  if [[ -s "$last_dir" ]]; then
    cd -- "$(cat "$last_dir")"
  fi
  rm -f -- "$last_dir"
}

makej() {
  make -j"$BUILD_JOBS" "$@"
}

if [[ -n "${D630_WORKSPACE:-}" && -d "$D630_WORKSPACE" ]]; then
  cd -- "$D630_WORKSPACE"
fi

if [[ -r /usr/share/bash-completion/bash_completion ]]; then
  source /usr/share/bash-completion/bash_completion
fi

if [[ -t 1 ]]; then
  PS1='\[\e[1;32m\]\u@\h\[\e[0m\] \[\e[1;34m\]\w\[\e[0m\]\$ '
fi
